# Copy to .env and fill in. .env is git-ignored and never read by the harness
# directly -- the code reads these from the process environment only.
#
# Required for any live Jev call (smoke / run --provider jev).
TYPESAFE_API_KEY=

# The general LLM judge (the third paid arm). Absent key => the adapter records
# not_run and nothing is sent. Only `run --provider openai`, `smoke --provider
# openai` and `list-models` read it; no other code path touches it.
OPENAI_API_KEY=

# Other general-model vendors. No endpoint or model ID has been verified for
# these, so their adapters refuse regardless of whether a key is present.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
